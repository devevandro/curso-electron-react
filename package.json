{
  "name": "rotion",
  "productName": "Rotion",
  "version": "1.0.0",
  "description": "A Notion alternative written with Electron",
  "main": "./out/main/index.js",
  "author": "rocketseat.com.br",
  "homepage": "https://www.rocketseat.com.br",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "electron-vite build && electron-builder --mac --config",
    "build:linux": "electron-vite build && electron-builder --linux --config",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^1.0.2",
    "@electron-toolkit/utils": "^1.0.2",
    "@radix-ui/react-collapsible": "^1.0.1",
    "@tailwindcss/typography": "^0.5.8",
    "@tanstack/react-query": "^4.19.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-typography": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "clsx": "^1.2.1",
    "cmdk": "^0.1.20",
    "electron-router-dom": "^1.0.5",
    "electron-store": "^8.1.0",
    "phosphor-react": "^1.4.1",
    "react-router-dom": "^7.18.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@rocketseat/eslint-config": "^1.1.3",
    "@types/node": "16.11.22",
    "@types/react": "18.0.21",
    "@types/react-dom": "18.0.6",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.13",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-notarize": "^1.2.1",
    "electron-vite": "^6.0.0",
    "eslint": "^8.25.0",
    "postcss": "^8.5.32",
    "tailwind-scrollbar": "^2.0.1",
    "tailwindcss": "^3.2.4",
    "typescript": "^4.8.4",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^4.0.2"
  }
}
